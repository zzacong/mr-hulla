{
  "name": "mr-hulla",
  "version": "0.3.1",
  "description": "Minimal experimental package — npx mr-hulla prints hello, from mr hulla",
  "keywords": [
    "cli",
    "experimental",
    "hello"
  ],
  "homepage": "https://github.com/zzacong/mr-hulla#readme",
  "bugs": {
    "url": "https://github.com/zzacong/mr-hulla/issues"
  },
  "license": "MIT",
  "author": "zzacong <zacong.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zzacong/mr-hulla.git"
  },
  "bin": {
    "mr-hulla": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "publint": "publint",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "mr-hulla-core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
