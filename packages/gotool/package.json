{
  "name": "mr-hulla-go",
  "version": "0.1.0",
  "description": "Minimal experimental CLI in Go — mr-hulla-go prints yo, from mr hulla (npm wrapper installs the right prebuilt binary)",
  "keywords": [
    "cli",
    "experimental",
    "go",
    "hello"
  ],
  "homepage": "https://github.com/zzacong/mr-hulla#readme",
  "bugs": {
    "url": "https://github.com/zzacong/mr-hulla/issues"
  },
  "license": "MIT",
  "author": "zzacong <zacong.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zzacong/mr-hulla.git"
  },
  "bin": {
    "mr-hulla-go": "./bin/mr-hulla-go.mjs"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "go test ./... && pnpm run build && node scripts/smoke.mjs",
    "typecheck": "echo 'mr-hulla-go: no types (Go source + JS launcher)'",
    "lint": "! gofmt -l . | grep . && go vet ./... && oxlint bin scripts",
    "publint": "publint",
    "prepublishOnly": "pnpm run build"
  },
  "optionalDependencies": {
    "mr-hulla-go-darwin-amd64": "workspace:*",
    "mr-hulla-go-darwin-arm64": "workspace:*",
    "mr-hulla-go-linux-arm64": "workspace:*",
    "mr-hulla-go-linux-x64": "workspace:*",
    "mr-hulla-go-windows-x64": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
